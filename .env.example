# Copy to .env.local and fill in. Never commit .env.local.
# Phase 4: server-side skin read (separate from the coding tool's key)
ANTHROPIC_API_KEY=
# Phase 5: waitlist + referrals
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AI try-on (haircut + beard on the user's photo). Opt-in per user; photo is not stored.
OPENAI_API_KEY=
# Optional: override the image model (default gpt-image-2)
OPENAI_IMAGE_MODEL=

# Higgsfield AI (Creative campaign generation from photo)
# Paste as "key_id:key_secret" from console.higgsfield.ai > API Keys
HIGGSFIELD_API_KEY=
# Or individual credentials:
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional: customize Higgsfield model endpoint (defaults to /higgsfield-ai/soul/standard)
HIGGSFIELD_MODEL_ENDPOINT=https://api.higgsfield.ai/higgsfield-ai/soul/standard
